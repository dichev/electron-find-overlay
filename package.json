    "electron",
    "find",
    "find-in-page",
    "findinpage",
    "native-search",
    "browser-search",
    "chromium",
    "findbar",
    "find-bar",
    "search",
    "search-bar",
    "ctrl-f",
    "overlay",
    "webcontentsview"
  ],
  "homepage": "https://github.com/dichev/electron-find-overlay#readme",
  "bugs": "https://github.com/dichev/electron-find-overlay/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichev/electron-find-overlay.git"
  },
  "license": "MIT",
  "author": "dichev <dichev.lab@gmail.com>",
  "type": "module",
  "exports": {
    "types": "./types/index.d.ts",
    "default": "./src/FindOverlay.js"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "start": "electron example/main.js"
  },
  "devDependencies": {
    "electron": "^44.5.1"
  },
